# UpSplit - environment
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored and never committed.
#
# Only the first two are needed to run the app. The rest turn on email.
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase, required ───────────────────────────────────────────────────────
#   Supabase Dashboard -> Project Settings -> API

# Project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Anon / publishable key. Safe to expose: RLS is what protects your data, not
# the secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...


# ── Email, optional ──────────────────────────────────────────────────────────
#
# Without these the app works normally and invitations still queue in
# email_outbox. They just are not delivered until a key exists, at which point
# everything queued goes out on the next dispatch. Nothing is lost by leaving
# this section empty for now.

# Service role key. SERVER ONLY. Bypasses every RLS policy.
# Needed to read email_outbox, which has RLS on and no policy at all, so it is
# invisible to anon and authenticated by design.
# Never prefix this with NEXT_PUBLIC_ and never import it into a client
# component.
#   Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key. SERVER ONLY.
#   https://resend.com -> API Keys -> Create
RESEND_API_KEY=

# Who invitations come from.
# Resend's shared onboarding@resend.dev sender needs no domain setup, but it
# can only deliver to the address that owns the Resend account. Fine for a
# smoke test, useless in production: verify a domain and use it here.
EMAIL_FROM=UpSplit <onboarding@resend.dev>

# The public origin, used to build absolute links in emails.
# On Vercel this is inferred from VERCEL_PROJECT_PRODUCTION_URL, so it only
# needs setting for local testing or a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the scheduled outbox drain. SERVER ONLY.
# Vercel Cron sends this automatically as a bearer token. Any long random
# string will do.
CRON_SECRET=
