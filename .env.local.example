# UpSplit — Supabase credentials
#
# Copy this file to `.env.local` and fill in the three values from your
# Supabase project. `.env.local` is gitignored and never committed.
#
#   Supabase Dashboard → Project Settings → API
#
# ─────────────────────────────────────────────────────────────────────────────

# Project URL — safe to expose to the browser.
#   Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Anon / publishable key — safe to expose. RLS is what protects your data,
# not the secrecy of this key.
#   Settings → API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key — SERVER ONLY. Bypasses every RLS policy.
# Optional: only needed for admin scripts (e.g. bulk-creating the seed users).
# Never prefix this with NEXT_PUBLIC_ and never import it into a client
# component.
#   Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=
