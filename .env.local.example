# UpSplit - environment
#
# Copy this file to `.env.local` and fill in the two values. `.env.local` is
# gitignored and never committed.
#
#   Supabase Dashboard -> Project Settings -> API
# ─────────────────────────────────────────────────────────────────────────────

# Project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Anon / publishable key. Also safe to expose: row-level security is what
# protects your data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# The public origin, used for share metadata and absolute links.
# Only needed locally. On Vercel it is inferred from the deployment, and
# setting it there would point preview builds at the wrong place.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
